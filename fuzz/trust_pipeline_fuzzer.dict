# p11-kit persistent format / trust store tokens
obj_hdr="[p11-kit-object-v1]"
obj_open="[["
obj_close="]]"
comment="#"
begin_cert="-----BEGIN CERTIFICATE-----"
end_cert="-----END CERTIFICATE-----"
uri="pkcs11:"
url_path="/CN=A"
cls="class:"
cls_cert="class: certificate"
cls_data="class: data"
type="type:"
type_x509="type: x-certificate"
value="value:"
label="label:"
id="id:"
trusted="trusted:"
distrusted="x-distrusted:"
purposes="x-purpose:"
semicolon=";"
colon=":"
percent="%25"
hex_ff="\xff"
len_ffffffff="\xff\xff\xff\xff"
